# Copy this file to .env.local and fill in real values.
# See README.md "Setup checklist" for where to get each of these.

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Product catalog -> your £7/month Price
STRIPE_PRICE_ID=price_...
# Developers -> Webhooks -> signing secret for the endpoint below
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
# Used to build absolute URLs for Stripe redirect/webhook and OAuth callbacks.
# Set to your Netlify URL in production (e.g. https://mediround.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
